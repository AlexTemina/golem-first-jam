config_version=5

[application]

config/name="Golem First Jam"
run/main_scene="res://golem_first_jam/managers/dumb_manager/dumb_manager.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

