;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Golem First Jam"
run/main_scene="uid://cn2k0h6ex3lfc"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="uid://d4f5cqy16i3l4"

[autoload]

SignalBus="*res://golem_first_jam/states/signal_bus/signal_bus.gd"
PhantomCameraManager="*uid://duq6jhf6unyis"

[display]

window/size/viewport_width=352
window/size/viewport_height=216
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[editor_plugins]

enabled=PackedStringArray("res://addons/phantom_camera/plugin.cfg")

